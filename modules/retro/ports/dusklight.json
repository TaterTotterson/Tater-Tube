{
  "schemaVersion": 1,
  "id": "dusklight",
  "title": "Dusklight (Twilight Princess)",
  "sourceUrl": "https://github.com/bmdhacks/dusklight/tree/gles-backend",
  "distribution": "bundled-patched-engine",
  "engineEnvironment": "TATER_TUBE_DUSKLIGHT",
  "romValidation": "engine",
  "romAccess": "direct",
  "romFolders": [
    "nintendo/gamecube",
    "nintendo/game cube",
    "nintendo/nintendo gamecube",
    "GameCube",
    "Game Cube",
    "Nintendo GameCube",
    "Nintendo - GameCube",
    "GC"
  ],
  "romExtensions": [
    "nkit.iso",
    "iso",
    "gcm",
    "ciso",
    "gcz",
    "nfs",
    "rvz",
    "wbfs",
    "wia",
    "tgc"
  ],
  "romNameHints": [
    "twilight princess"
  ],
  "executables": {
    "linux-x86_64": [
      "dusklight"
    ],
    "linux-arm64": [
      "dusklight"
    ]
  },
  "validationArguments": [
    "--tater-validate-disc",
    "{romPath}"
  ],
  "launchArguments": [
    "--dvd",
    "{romPath}",
    "--backend",
    "opengles",
    "--cvar",
    "video.enableFullscreen=true",
    "--cvar",
    "video.enableVsync=false",
    "--cvar",
    "video.maxFrameRate=30",
    "--cvar",
    "video.decoupleSimFromRender=true"
  ],
  "crtLaunchArguments": []
}
